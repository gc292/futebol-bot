# Add these to the bot's existing .env; retain DISCORD_TOKEN.
# The exact Discord server ID is essential: data is isolated per guild.
FOOTBALL_GUILD_ID=replace-with-your-discord-server-id
FOOTBALL_WEB_KEY=replace-with-a-long-private-access-key
FOOTBALL_ADMIN_PASSWORD=replace-with-your-private-player-password
# To expose on your home LAN, replace this with the home server's LAN address.
FOOTBALL_WEB_BIND=127.0.0.1
# Voting links work automatically; no Google or Discord login credentials are needed.
# Set true when the public website is served over HTTPS; leave false for local HTTP.
FOOTBALL_WEB_SECURE_COOKIES=false

# Optional shared MariaDB connection (see SIGMA.md). Leave unset to keep SQLite.
# FOOTBALL_DB_URL=jdbc:mariadb://db.tecnico.ulisboa.pt:3306/ist123456
# FOOTBALL_DB_USER=ist123456
# FOOTBALL_DB_PASSWORD=your-database-password
